{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paradox Catalog Entry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "domain": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "predicate": { "type": "string" },
    "j1_origin": { "type": "string" },
    "j2_extension": { "type": "string" },
    "p_remainder": { "type": "string" },
    "gate_operator": { "type": "string" },
    "gate_type": {
      "type": "string",
      "enum": ["Door", "Gate"]
    },
    "admissibility_change": { "type": "string" },
    "output_class": {
      "type": "string",
      "enum": [
        "preserved",
        "transformed",
        "split",
        "null",
        "extinct",
        "proxy-substituted"
      ]
    },
    "root_cause": {
      "type": "string",
      "enum": ["extension_error", "construction_error", "mixed"]
    },
    "suggested_fix": { "type": "string" },
    "fix_type": {
      "type": "string",
      "enum": [
        "hierarchy",
        "retype",
        "rebuild",
        "enlarge_arena",
        "construct_boat",
        "paraconsistent",
        "probabilistic",
        "other"
      ]
    },
    "boat_candidate": { "type": "string" },
    "measurables": { "type": "string" },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": { "type": "string" },
    "created_by": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "id",
    "name",
    "domain",
    "predicate",
    "j1_origin",
    "j2_extension",
    "gate_type",
    "output_class"
  ]
}
