{
  "protocol_version": "adaptive_qrtc_development_v4.0",
  "frozen_before_execution": true,
  "one_shot_execution": true,
  "experiment_class": "development_not_validation",
  "training_source": "archived_v1_v2_v3 development mechanisms only",
  "evaluation_manifest": "adaptive_v4_fresh_mechanisms.json",
  "primary_policy": "routed_hybrid_qrtc_v4",
  "frozen_baseline": "hybrid_qrtc_v2",
  "router": {
    "feature_policy": "public observations, public history, and V2/V3 decision disagreement only",
    "lcb_z": 1.645,
