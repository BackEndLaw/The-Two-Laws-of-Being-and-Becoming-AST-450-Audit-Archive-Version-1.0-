    "balanced_classes_required": true
  },
  "bootstrap": {
    "method": "dynamical-class-stratified paired cluster bootstrap",
    "resamples": 2000,
    "seed": 3450
  },
  "acceptance": {
    "aggregate_advantage_minimum": 0.0,
    "aggregate_interval_lower_minimum": 0.0,
    "family_noninferiority_margin": 0.05,
    "minimum_positive_family_count": 2,
    "maximum_unsafe_rate_increase": 0.0,
    "maximum_harm_rate": 0.05,
    "graph_invalid_action_rate": 0.0,
    "activated_incremental_utility_minimum": 0.0,
    "leakage_tests_required": true
  },
  "failure_policy": "stop current experimental series and redesign benchmark",
  "validation_authorized": false,
  "hardware_actuation_enabled": false,
  "hardware_gate": "NOT READY"
}